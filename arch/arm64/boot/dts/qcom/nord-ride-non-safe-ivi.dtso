&thermal_zones {
	cpu-0-1-0-thermal {
		trips {
			cpu1_alert0_0: cpu1-alert0-0 {
				temperature = <114000>;
				hysteresis = <3000>;
				type = "passive";
			};
		};

		cooling-maps {
			map-cpu1-0 {
				trip = <&cpu1_alert0_0>;
				cooling-device = <&CPU1_idle 100 100>;
			};
		};
	};

	cpu-0-1-1-thermal {
		trips {
			cpu1_alert0_1: cpu1-alert0-1 {
