/dts-v1/;
/plugin/;

/ {
	compatible = "qcom,nord-ride", "qcom,nord";
};

&{/} {
	model = "Qualcomm Technologies, Inc. NORD v2 NON-SAFE IVI RIDE-SX";
	compatible = "qcom,nord-ride-non-safe-ivi", "qcom,non-safe-ivi",
		     "qcom,nord-ride", "qcom,nord";
};

&cpu0 {
	#cooling-cells = <2>;
};

&cpu1 {
	#cooling-cells = <2>;
	CPU1_idle: thermal-idle {
		#cooling-cells = <2>;
		duration-us = <800000>;
		exit-latency-us = <10000>;
	};
};

