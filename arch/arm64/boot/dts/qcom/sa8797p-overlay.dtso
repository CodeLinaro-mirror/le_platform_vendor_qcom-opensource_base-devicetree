&cpucp_scmi {
	status = "okay";
};

&scmi43_pinctrl{
	scmi43_gpio: gpio {
		gpio-controller;
	};

};

&soc {
	kaslr_store {
		compatible = "qcom,kaslr-off-store";
		reg = <0x0 0x146806d0 0x0 0xc>;
	};

	dload_mode {
		compatible = "qcom,dload-mode";
	};

	dload_type {
		compatible = "qcom,msm-imem-dload-type";
		reg = <0x0 0x1468001c 0x0 0x4>;
	};

	kiumd {
		compatible = "qcom,kiumd";
		qcom,dev-name = "kiumd";
		status = "ok";
	};

	mini_dump_mode {
		compatible = "qcom,minidump";
		status = "ok";
	};

	scm_user_intf_device {
		compatible = "qcom,scm-user-intf";
		scm_dev = "scm";
		status = "ok";
	};

	scm_user_intf_sec_device {
		compatible = "qcom,scm-user-intf-sec";
		memory-region = <&tzcom_mem>;
		status = "ok";
	};

	qtee_shmbridge {
		compatible = "qcom,tee-shared-memory-bridge";
	};

	qcom_smcinvoke {
		compatible = "qcom,smcinvoke";
	};

	qcom_tzlog: tz-log@14680720 {
		compatible = "qcom,tz-log";
		reg = <0x0 0x14680720 0x0 0x3000>;
		qcom,hyplog-enabled;
		hyplog-address-offset = <0x410>;
		hyplog-size-offset = <0x414>;
		tmecrashdump-address-offset = <0x87000000>;
	};

	qcom,secure-buffer {
		compatible = "qcom,secure-buffer";
	};

	qcom,mem-buf {
		compatible = "qcom,mem-buf";
		qcom,mem-buf-capabilities = "supplier";
		qcom,vmid = <3>;
	};

	scmi_nsp0 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi19_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_nsp0";
	};

	scmi_nsp1 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi19_dvfs 1>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_nsp1";
	};

	scmi_nsp2 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi19_dvfs 2>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_nsp2";
	};

	scmi_nsp3 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi19_dvfs 3>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_nsp3";
	};

	scmi_hpass0 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi19_dvfs 4>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_hpass0";
	};

	scmi_hpass1 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi19_dvfs 5>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_hpass1";
	};

	scmi_hpass2 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi19_dvfs 6>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_hpass2";
	};

	scmi_mdss0 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi16_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_mdss0";
	};

	scmi_mdss1 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi17_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_mdss1";
	};

	scmi_mdss0_safe {
		compatible = "qcom,uscmi";

		power-domains = <&scmi38_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_mdss0_safe";
	};

	scmi_mdss1_safe {
		compatible = "qcom,uscmi";

		power-domains = <&scmi39_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_mdss1_safe";
	};

	scmi_mdss0_secure {
		compatible = "qcom,uscmi";

		power-domains = <&scmi40_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_mdss0_secure";
	};

	scmi_mdss1_secure {
		compatible = "qcom,uscmi";

		power-domains = <&scmi41_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_mdss1_secure";
	};

	scmi_camera {
		compatible = "qcom,uscmi";

		power-domains = <&scmi21_dvfs 0>;
		power-domain-names = "perf_camera_0";

		qcom,dev-name = "scmi_camera";
		};
	scmi_camera_ccu_clock {
		compatible = "qcom,uscmi";

		power-domains = <&scmi21_dvfs 1>;
		power-domain-names = "perf_camera_1";

		qcom,dev-name = "scmi_camera_ccu_clock";
		};

	scmi_camera_pdb0 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi21_dvfs 2>;
		power-domain-names = "perf_camera_config_gpio_0";

		qcom,dev-name = "scmi_camera_pdb0";
        };
	scmi_camera_pdb1 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi21_dvfs 3>;
		power-domain-names = "perf_camera_config_gpio_1";

		qcom,dev-name = "scmi_camera_pdb1";
        };
	scmi_camera_pdb2 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi21_dvfs 4>;
		power-domain-names = "perf_camera_config_gpio_2";

		qcom,dev-name = "scmi_camera_pdb2";
        };
	scmi_camera_pdb3 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi21_dvfs 5>;
		power-domain-names = "perf_camera_config_gpio_3";

		qcom,dev-name = "scmi_camera_pdb3";
        };
	scmi_camera_pdb4 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi21_dvfs 6>;
		power-domain-names = "perf_camera_config_gpio_4";

		qcom,dev-name = "scmi_camera_pdb4";
        };


	scmi_dprx0 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi27_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_dprx0";
	};

	scmi_dprx1 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi28_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_dprx1";
	};

	scmi1_safety {
		qcom,dev-name = "safety-profile-0";
		compatible = "qcom,uscmi-vendor";
		qcom,algo = <0x00 0x73616665>;
		qcom,vendor = <&vendor_pdp>;
	};

	scmi2_safety {
		qcom,dev-name = "safety-profile-1";
		compatible = "qcom,uscmi-vendor";
		qcom,algo = <0x00 0x73616665>;
		qcom,vendor = <&vendor_pdp1>;
	};

	scmi3_safety {
		qcom,dev-name = "safety-profile-2";
		compatible = "qcom,uscmi-vendor";
		qcom,algo = <0x00 0x73616665>;
		qcom,vendor = <&vendor_pdp2>;
	};

	scmi_uetm {
		qcom,dev-name = "uetm";
		compatible = "qcom,uscmi-vendor";
		qcom,algo = <0x00 0x5545544d>;
		qcom,vendor = <&vendor_cpupcp>;
	};

	test_scmi {
                compatible = "qcom,uscmi";

                power-domains = <&scmi63_pd 2> , <&scmi63_dvfs 2>;
                power-domain-names = "power", "perf";

                resets = <&scmi63_rst 0>;
                reset-names = "core";

                qcom,dev-name = "test_scmi";
        };

        test_scmi_perf {
                compatible = "qcom,uscmi";

                power-domains = <&scmi63_dvfs 1>;
                power-domain-names = "perf";

                qcom,dev-name = "test_scmi_perf";
        };

        test_scmi_power {
                compatible = "qcom,uscmi";

                power-domains = <&scmi63_pd 1>;

                qcom,dev-name = "test_scmi_power";
        };

	scmi_usb2 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi2_pd 0>, <&scmi2_pd 1>;
		power-domain-names = "usb_transfer", "usb_core";

		qcom,dev-name = "scmi_usb2";
	};

	scmi_usb2_phy2 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi14_pd 0>, <&scmi14_pd 1>;
		power-domain-names = "usb_transfer", "usb_core";

		qcom,dev-name = "scmi_usb2_phy2";
	};

	scmi_uart14 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi11_pd 14>, <&scmi11_dvfs 14>;
		power-domain-names = "power", "perf";

		qcom,dev-name = "scmi_uart14";
	};

	scmi_uart17 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi11_pd 17>, <&scmi11_dvfs 17>;
		power-domain-names = "power", "perf";

		qcom,dev-name = "scmi_uart17";
	};

	scmi_emac1 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi8_pd 0>, <&scmi8_pd 1>, <&scmi8_dvfs 0>, <&scmi8_dvfs 1>;
		power-domain-names = "emac_power", "emac_clock", "emac_perf", "perf_5g_serdes";

		resets = <&scmi8_rst 0>, <&scmi8_rst 1>;
		reset-names = "emac_reset", "serdes_reset";

		qcom,no-suspend;
		qcom,dev-name = "scmi_emac1";
	};

	scmi_bluetooth {
		compatible = "qcom,uscmi";

		power-domains = <&scmi25_pd 0>, <&scmi25_pd 1>;
		power-domain-names = "power_regulator", "power_gpio";
		qcom,dev-name = "scmi_bluetooth";
	};

	scmi_bluetooth1 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi46_pd 0>, <&scmi46_pd 1>;
		power-domain-names = "power_regulator", "power_gpio";
		qcom,dev-name = "scmi_bluetooth1";
	};

	scmi_pcie2 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi32_pd 0>, <&scmi63_pd 0>;
		power-domain-names = "power", "dummy";
		qcom,no-suspend;
		qcom,dev-name = "scmi_pcie2";
	};

	scmi_pcie3 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi33_pd 0>, <&scmi63_pd 0>;
		power-domain-names = "power", "dummy";
		qcom,no-suspend;
		qcom,dev-name = "scmi_pcie3";
	};

	scmi_wlan {
		compatible = "qcom,uscmi";

		power-domains = <&scmi24_pd 0>, <&scmi24_pd 1>;
		power-domain-names = "power_regulator", "power_gpio";

		qcom,dev-name = "scmi_wlan";
	};

	scmi_wlan1 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi45_pd 0>, <&scmi45_pd 1>;
		power-domain-names = "power_regulator", "power_gpio";

		qcom,dev-name = "scmi_wlan1";
	};

	tlmm_fusa {
		compatible = "qcom,tlmm-fusa";
		interrupts = <GIC_SPI 97 IRQ_TYPE_EDGE_RISING>;
		reg = <0x0 0xf1ea000 0x0 0x2>,
		      <0x0 0xf21c000 0x0 0x4>,
		      <0x0 0xf21c008 0x0 0x4>;
		reg-names = "error_status", "ahb_hreset_status", "por_ares_status";
		qcom,por-ares-reset-bit = <6>;
	};

	scmi_soccp {
		compatible = "qcom,uscmi";

		power-domains = <&scmi29_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_soccp";
	};

	scmi_gpce {
		compatible = "qcom,uscmi";

		power-domains = <&scmi30_dvfs 0>, <&scmi30_dvfs 1>, <&scmi30_dvfs 2>;
		power-domain-names = "gpce_core0", "gpce_core1", "gpce_core2";

		qcom,dev-name = "scmi_gpce";
	};

	scmi_usb1 {
		compatible = "qcom,uscmi";
		power-domains = <&scmi1_pd 0>, <&scmi1_pd 1>;
		power-domain-names = "usb_transfer", "usb_core";

		qcom,dev-name = "scmi_usb1";
	};

	scmi_usb1_phy2 {
		compatible = "qcom,uscmi";
		power-domains = <&scmi13_pd 0>, <&scmi13_pd 1>;
		power-domain-names = "usb_transfer", "usb_core";

		qcom,dev-name = "scmi_usb1_phy2";
	};

	scmi_usb1_qmp {
		compatible = "qcom,uscmi";
		power-domains = <&scmi13_pd 2>, <&scmi13_pd 3>;
		power-domain-names = "usb_transfer", "usb_core";

		qcom,dev-name = "scmi_usb1_qmp";
	};
};

