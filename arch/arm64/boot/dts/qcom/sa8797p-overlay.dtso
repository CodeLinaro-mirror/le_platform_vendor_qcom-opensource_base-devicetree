/dts-v1/;
/plugin/;

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include "oot-dt-bindings/qcom-ipcc-sa8797p.h"
#include "sa8797p-vfio.dtsi"
#include "sa8797p-vms.dtsi"
#include "sa8797p-dma-heaps.dtsi"
#include "sa8797p-vms-lv.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. SA8x97P";
	compatible = "qcom,sa8797p";
};

&{/} {
	tz_start_count {
		compatible = "qcom,nhlos-logs-io", "qcom,nhlos-logs";
		memory-region = <&tz_start_count>;
	};

	tz_end_count {
		compatible = "qcom,nhlos-logs-io", "qcom,nhlos-logs";
		memory-region = <&tz_end_count>;
	};
};

&{/reserved-memory} {
	cma: linux,cma {
		compatible = "shared-dma-pool";
		alloc-ranges = <0x0 0x00000000 0x0 0xdfffffff>;
		reusable;
		alignment = <0x0 0x400000>;
		size = <0x0 0x2000000>;
		linux,cma-default;
	};
	qseecom_mem: qcom,qseecom {
		compatible = "shared-dma-pool";
		alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
		reusable;
		alignment = <0x0 0x400000>;
		size = <0x0 0x1400000>; /* 20M */
	};

	qseecom_ta_mem: qcom,qseecom-ta {
		compatible = "shared-dma-pool";
		alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
		reusable;
		alignment = <0x0 0x400000>;
		size = <0x0 0x1000000>; /* 16M */
	};

	tzcom_mem: qcom,tzcom {
		compatible = "shared-dma-pool";
		alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
		reusable;
		alignment = <0x0 0x400000>;
		size = <0x0 0x1400000>; /* 20M */
	};

	tz_start_count: tz_start_count {
		reg = <0x0 0x146807f8 0x0 0x8>;
		no-map;
	};

	tz_end_count: tz_end_count {
		reg = <0x0 0x146807dc 0x0 0x8>;
		no-map;
	};

	non_ecc_heap_mem: non_ecc_heap_mem_region {
		/* must be overridden by DDR-specific overlay */
		reg = <0x0 0x00000000 0x0 0x00000000>;
		no-map;
		status = "disabled";
	};
};

&scmi1 {
	status = "okay";
};

&scmi2 {
	status = "okay";
};

