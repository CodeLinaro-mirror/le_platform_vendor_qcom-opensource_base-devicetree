#include "oot-dt-bindings/qcom-shmem-sa8797p.h"

&soc {
	auto_vm: qcom,auto_vm@B60000000 {
		reg = <0xB 0x60000000 0x0 0x3000000>; /* 48MB */
		vm_name = "autoghgvm";
		shared-buffers = <&auto_vm_vblk0_ring
				&auto_vm_vblk1_ring
				&auto_vm_vblk2_ring
