				>;
	};

	qcom,test-dbl-gvm1 {
		compatible = "qcom,gh-dbl";
		qcom,label = <0x4>;
	};

	qcom,test-dbl-gvm2 {
		compatible = "qcom,gh-dbl";
		qcom,label = <0x5>;
	};

	qcom,test-msgq-gvm1 {
		compatible = "qcom,gh-msgq-test";
		gunyah-label = <4>;
		qcom,primary;
	};

	qcom,test-msgq-gvm2 {
		compatible = "qcom,gh-msgq-test";
		gunyah-label = <5>;
		qcom,primary;
	};

	qcom,gh-qtimer@17C25000 {
		compatible = "qcom,gh-qtmr";
		reg = <0x0 0x17C25000 0x0 0x1000>;
		reg-names = "qtmr-base";
		interrupts = <GIC_SPI 10 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "qcom,qtmr-intr";
		qcom,primary;
	};
};

&soccp_fe_vm_1 {
	gunyah-label = <0x80>;
	qcom,is-shared;
};

&{/reserved-memory} {
	#address-cells = <2>;
	#size-cells = <2>;
	ranges;

	glink_cma_mem1: glink_cma_mem1@80800000 {
		no-map;
		reg = <0x0 0x80800000 0x0 0x9000>;
		qcom,dst-vmids = <AC_VM_CDSP_Q6_ELF_00>;
		qcom,dst-perms = <QCOM_PERM_RWX>;
		gunyah-label = <0x60>;
	};

	glink_cma_mem2: glink_cma_mem2@80809000 {
