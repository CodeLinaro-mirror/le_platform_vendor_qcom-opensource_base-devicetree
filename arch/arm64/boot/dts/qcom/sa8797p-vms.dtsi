	dice_vm_0: dice-vm@0 {
		compatible = "qcom,dice-vm";
		memory-region = <&dice_vm_0_mem>;
		qcom,vm-loader = <&auto_vm_0>;
		qcom,vm = <&auto_vm>;
	};

	auto_vm_0: gh-secure-vm-loader@0 {
		compatible = "qcom,gh-secure-vm-loader";
		qcom,pas-id = <44>;
		qcom,vmid = <52>;
		qcom,firmware-name = "autoghgvm";
		qcom,firmware-index = <0>;

		enable-gvm-dump;
		virtio-backends = <&auto_vm_be0
				&auto_vm_be1
				&auto_vm_be2
				&auto_vm_be3
				&auto_vm_be4
				&auto_vm_be5
