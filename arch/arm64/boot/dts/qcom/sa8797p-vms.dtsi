	auto_vm_0: gh-secure-vm-loader@0 {
		compatible = "qcom,gh-secure-vm-loader";
		qcom,pas-id = <44>;
		qcom,vmid = <52>;
		qcom,firmware-name = "autoghgvm";
		qcom,firmware-index = <0>;
		memory-region = <&auto_vm_0_mem_0 &auto_vm_0_mem_1 &auto_vm_0_mem_2 &auto_vm_0_mem_3 &auto_vm_0_mem_4 &auto_vm_0_mem_5 &auto_vm_0_mem_6>;
		shared-regions = <&glink_cma_mem1 &glink_cma_mem2 &glink_cma_mem3 &glink_cma_mem4 &glink_cma_mem5 &glink_cma_mem6 &glink_cma_mem7 &vm_cp_pixel &vm_cp_nonpixel &vm_cp_bitstream &soccp_fe_vm_1>;
		enable-gvm-dump;
		virtio-backends = <&auto_vm_be0
				&auto_vm_be1
				&auto_vm_be2
				&auto_vm_be3
				&auto_vm_be4
				&auto_vm_be5
