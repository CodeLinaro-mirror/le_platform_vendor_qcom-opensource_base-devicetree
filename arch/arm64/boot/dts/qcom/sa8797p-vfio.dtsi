	qdss_cb {
		compatible = "qcom,vfio-platform";
		iommus = <&apps_smmu_0 0x1860 0x0>,
			<&apps_smmu_0 0x1880 0x0>;
		dma-coherent;
	};

	qdss_etr_irq {
		compatible = "qcom,vfio-platform";
		interrupts = <GIC_SPI 738 IRQ_TYPE_EDGE_RISING>;
		iommus = <&apps_smmu_1 0x0880 0x0>;
		dma-coherent;
	};

	vfio_hsi2s@4F00000 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x4F00000 0x0 0x60000>,
			<0x0 0x5011000 0x0 0x20000>;
		pinctrl-names = "default";
		pinctrl-0 = <&aud_intfc4_sck_active &aud_intfc4_ws_active
			&aud_intfc4_data0_active &aud_intfc4_data1_active
			&aud_intfc5_sck_active &aud_intfc5_ws_active
			&aud_intfc5_data0_active &aud_intfc5_data1_active>;

		interrupts = <GIC_SPI 88 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&apps_smmu_0 0x0ABB 0x0>,
			<&apps_smmu_0 0x0ABC 0x1>;
		qcom,iommu-dma-addr-pool = <0x0 0x0 0x0 0xFFFFFFFF>;
		dma-coherent;
	};

	vfio_soccp@9007000 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x9007000 0x0 0x1000>,
			<0x0 0x89B00000 0x0 0x400000>,
			<0x0 0x01FD4000 0x0 0x1000>,
			<0x0 0x01FB5000 0x0 0x1000>,
			<0x0 0x00DA2000 0x0 0x1000>,
			<0x0 0x9305000 0x0 0x1000>,
			<0x0 0x931B000 0x0 0x1000>,
			<0x0 0x931C000 0x0 0x1000>;

		interrupts-extended = <&ipcc0 IPCC_MPROC_SOCCP 2 IRQ_TYPE_LEVEL_HIGH>,
				<&intc GIC_SPI 167 IRQ_TYPE_LEVEL_HIGH>,
				<&intc GIC_SPI 229 IRQ_TYPE_LEVEL_HIGH>;

		iommus = <&apps_smmu_0 0x1962 0x1>;
		dma-coherent;
	};

	subsystem_ramdump_util@89b00000 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x89b00000 0x0 0x400000>,			//SMEM
			<0x0 0x8d900000 0x0 0x2300000>,			//NSP0
			<0x0 0x8fc00000 0x0 0x2300000>,			//NSP1
			<0x0 0x91f00000 0x0 0x2300000>,			//NSP2
			<0x0 0x94200000 0x0 0x2300000>,			//NSP3
			<0x0 0x96500000 0x0 0x2800000>,			//HPASS0
			<0x0 0x98d00000 0x0 0x2800000>,			//HPASS1
			<0x0 0x9b500000 0x0 0x2800000>,			//HPASS2
			<0x0 0x01FD4000 0x0 0x1000>;			//JTAG
		iommus = <&apps_smmu_2 0x1760 0x0>;
		dma-coherent;
	};

	vfio_hwkm_gpce_core_0@1dc0000 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x01dc0000 0x0 0x00040000>;
		iommus = <&apps_smmu_0 0x1689 0x0>;
		qcom,iommu-dma-addr-pool = <0x0 0x0 0x0 0xffffffff>;
		dma-coherent;
	};

	vfio_gpce_gvm_ns_tzdec_cb {
		compatible = "qcom,vfio-platform";
		iommus = <&apps_smmu_0 0x1681 0x0>;
		qcom,iommu-dma-addr-pool = <0x0 0x0 0x0 0xffffffff>;
		dma-coherent;
	};

	vfio_gpce_gvm_s_tzdec_cb {
		compatible = "qcom,vfio-platform";
		iommus = <&apps_smmu_0 0x1688 0x0>;
		qcom,iommu-dma-addr-pool = <0x0 0x0 0x0 0xffffffff>;
		qcom,iommu-vmid = <0x9>; /*VMID_CP_BITSTREAM */
		qcom,secure-context-bank;
		dma-coherent;
	};
};
