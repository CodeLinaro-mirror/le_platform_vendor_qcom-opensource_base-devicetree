			<&ipcc1 IPCC_COMPUTE_L0_NSP3 IPCC_COMPUTE_L0_SIGNAL_IPCLITE_MSG IRQ_TYPE_EDGE_RISING>,
			<&ipcc1 IPCC_COMPUTE_L0_NSP3 IPCC_COMPUTE_L0_SIGNAL_IPCLITE_MEM_INIT IRQ_TYPE_EDGE_RISING>,
			<&ipcc1 IPCC_COMPUTE_L0_NSP3 IPCC_COMPUTE_L0_SIGNAL_IPCLITE_VERSION IRQ_TYPE_EDGE_RISING>,
