			<&ipcc1 IPCC_COMPUTE_L0_NSP0 IPCC_COMPUTE_L0_SIGNAL_IPCLITE_MSG IRQ_TYPE_EDGE_RISING>,
			<&ipcc1 IPCC_COMPUTE_L0_NSP0 IPCC_COMPUTE_L0_SIGNAL_IPCLITE_MEM_INIT IRQ_TYPE_EDGE_RISING>,
			<&ipcc1 IPCC_COMPUTE_L0_NSP0 IPCC_COMPUTE_L0_SIGNAL_IPCLITE_VERSION IRQ_TYPE_EDGE_RISING>,
			<&ipcc1 IPCC_COMPUTE_L0_NSP0 IPCC_COMPUTE_L0_SIGNAL_IPCLITE_TEST IRQ_TYPE_EDGE_RISING>,
			<&ipcc1 IPCC_COMPUTE_L0_NSP0 IPCC_COMPUTE_L0_SIGNAL_IPCLITE_SSR IRQ_TYPE_EDGE_RISING>,
			<&ipcc1 IPCC_COMPUTE_L0_NSP0 IPCC_COMPUTE_L0_SIGNAL_IPCLITE_DEBUG IRQ_TYPE_EDGE_RISING>,
			<&ipcc1 IPCC_COMPUTE_L0_NSP1 IPCC_COMPUTE_L0_SIGNAL_IPCLITE_MSG IRQ_TYPE_EDGE_RISING>,
