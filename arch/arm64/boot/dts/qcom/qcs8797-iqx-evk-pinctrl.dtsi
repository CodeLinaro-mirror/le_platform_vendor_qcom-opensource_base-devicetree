&soc {
	rtc@0 {
		compatible = "qcom,apps-pinctlr";
		pinctrl-names = "default";
		pinctrl-0 = <&rtc_sda &rtc_scl>;
	};
	modem_pin@0 {
		compatible = "qcom,apps-pinctlr";
		pinctrl-names = "default";
		pinctrl-0 = <&modem_pin_53 &modem_pin_54
					&modem_pin_83 &modem_pin_84
					&modem_pin_85 &modem_pin_86
					&modem_pin_108 &modem_pin_142
					&modem_pin_172 &modem_pin_173
					&modem_pin_174 &modem_pin_175
					&modem_pin_176 &modem_pin_177>;
	};
	io_expansion_connector@0 {
		compatible = "qcom,apps-pinctlr";
		pinctrl-names = "default";
		pinctrl-0 = <&io_expansion_connector_93 &io_expansion_connector_94>;
	};
	md_spi_can@0 {
		compatible = "qcom,apps-pinctlr";
		pinctrl-names = "default";
		pinctrl-0 = <&md_spi_can_16 &md_spi_can_21
					&md_spi_can_22 &md_spi_can_25
					&md_spi_can_28 &md_spi_can_38
					&md_spi_can_45 &md_spi_can_46
					&md_spi_can_56>;
	};

	usb_hub@0 {
		compatible = "qcom,apps-pinctlr";
		pinctrl-names = "default";
		pinctrl-0 = <&usb_hub_rst>;
	};

	IQ_qupv3_pins@0 {
		compatible = "qcom,apps-pinctlr";
		pinctrl-names = "default";
		pinctrl-0 = <&qupv3_se0_0_l0 &qupv3_se0_0_l1
					&qupv3_se0_0_l2 &qupv3_se0_0_l3
					&qupv3_se2_0_l0 &qupv3_se2_0_l1
					&qupv3_se3_0_l0 &qupv3_se3_0_l1
					&qupv3_se6_1_l0 &qupv3_se6_1_l1
					&qupv3_se0_2_l0 &qupv3_se0_2_l1
					&qupv3_se2_2_l0 &qupv3_se2_2_l1
					&qupv3_se2_2_l2 &qupv3_se2_2_l3
					&qupv3_se2_2_l4 &qupv3_se5_2_l0
					&qupv3_se5_2_l1 &qupv3_se0_3_l0
					&qupv3_se0_3_l1 &qupv3_se0_3_l2
					&qupv3_se0_3_l3 &qupv3_se0_3_l4
					&qupv3_se0_3_l5>;
	};
};