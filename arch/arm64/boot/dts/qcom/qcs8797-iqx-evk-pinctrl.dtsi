&tlmm {
	soc_vbus_det_default: usb1_hub_pin_default {
		mux {
			pins = "gpio169";
			function = "gpio";
		};
		config {
			pins = "gpio169";
			drive-strength = <2>;    /* 2 mA */
			bias-pull-up;             /* PULL UP */
			output-high;
		};
	};
	rtc: rtc {
		rtc_sda: rtc_sda {
			mux {
				pins = "gpio123";
				function = "gpio";
			};
			config {
				pins = "gpio123";
				drive-strength = <2>;   /* 2 mA */
				bias-disable;           /* External pull-ups */
			};
		};
		rtc_scl: rtc_scl {
			mux {
				pins = "gpio124";
				function = "gpio";
			};
			config {
				pins = "gpio124";
				drive-strength = <2>;   /* 2 mA */
				bias-disable;           /* External pull-ups */
			};
		};
	};
