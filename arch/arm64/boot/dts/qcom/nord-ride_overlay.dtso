&soc {
	ddr_bwprofiler: ddr_bwprofiler {
		compatible = "qcom,sa8797_ddr_bwprofiler";
		reg = <0x0 0x21800000 0x0 0x0200000>,
		    <0x0 0x21A00000 0x0 0x0200000>,
		    <0x0 0x21C00000 0x0 0x0200000>,
		    <0x0 0x21E00000 0x0 0x0200000>,
		    <0x0 0x22800000 0x0 0x0200000>,
		    <0x0 0x22A00000 0x0 0x0200000>,
		    <0x0 0x22C00000 0x0 0x0200000>,
		    <0x0 0x22E00000 0x0 0x0200000>,
		    <0x0 0x23800000 0x0 0x0200000>,
		    <0x0 0x23A00000 0x0 0x0200000>,
		    <0x0 0x23C00000 0x0 0x0200000>,
		    <0x0 0x23E00000 0x0 0x0200000>,
		    <0x0 0x24800000 0x0 0x0200000>,
		    <0x0 0x24A00000 0x0 0x0200000>,
		    <0x0 0x24C00000 0x0 0x0200000>,
		    <0x0 0x24E00000 0x0 0x0200000>,
		    <0x0 0x0232b000 0x0 0x0001000>,
		    <0x0 0x0232c000 0x0 0x0001000>,
		    <0x0 0x0242b000 0x0 0x0001000>,
		    <0x0 0x0242c000 0x0 0x0001000>,
		    <0x0 0x0252b000 0x0 0x0001000>,
		    <0x0 0x0252c000 0x0 0x0001000>,
		    <0x0 0x0272b000 0x0 0x0001000>,
		    <0x0 0x0272c000 0x0 0x0001000>,
		    <0x0 0x01790000 0x0 0x0050000>;
	};
};
