&scmi43 {
	scmi43_pinctrl: protocol@19 {
		reg = <0x19>;

		scmi43_gpio: gpio {
			gpio-controller;
		};
	};
};

&pdp_scmi {
	vendor_pdp: protocol@80 {
		reg = <0x80>;
		#clock-cells = <1>;
	};
};

&pdp0_mbox {
	qcom,rx-chans = <0x80b>;
};


&{/psci} {
    reboot-mode {
        mode-bootloader = <0x80010001 0x2>;
        mode-edl = <0x80000000 0x1>;
    };

};

&qupv3_1 {
    status = "okay";
};

&{/aliases} {
	i2c9 = "/soc@0/geniqup@ac0000/i2c@a88000";
};

&i2c18 {
	status = "okay";
};

&i2c9 {
       compatible = "qcom,sa8797p-geni-i2c",
                    "qcom,sa8255p-geni-i2c";
       dmas = <&gpi_dma1 0 2 QCOM_GPI_I2C>,
              <&gpi_dma1 1 2 QCOM_GPI_I2C>;
       dma-names = "tx", "rx";
       power-domains = <&scmi9_pd 9>,
                        <&scmi9_dvfs 9>;
       power-domain-names = "power",
                             "perf";
       #address-cells = <1>;
       #size-cells = <0>;
       status = "okay";
};

&gpi_dma1 {
	status = "okay";
};

&scmi9 {
	status = "okay";
};

&adreno_smmu_0 {
    power-domains = <&scmi15_pd 0>;
    power-domain-names = "power";
    status = "okay";
};

&adreno_smmu_1 {
    power-domains = <&scmi15_pd 1>;
    power-domain-names = "power";
    status = "okay";
};

