						qcom,dump-size = <0x100000>;
						qcom,dump-id = <0x230>;
						qcom,instance = <0xf>;
					};

					cache_cpu16 {
						qcom,dump-size = <0x100000>;
						qcom,dump-id = <0x230>;
						qcom,instance = <0x10>;
					};

					cache_cpu17 {
						qcom,dump-size = <0x100000>;
						qcom,dump-id = <0x230>;
						qcom,instance = <0x11>;
					};
				};

				cluster_cache {
					cl_cache0 {
						qcom,dump-size = <0x1000000>;
						qcom,dump-id = <0x240>;
						qcom,instance = <0x0>;
					};

					cl_cache1 {
						qcom,dump-size = <0x1000000>;
						qcom,dump-id = <0x240>;
						qcom,instance = <0x1>;
					};

					cl_cache2 {
						qcom,dump-size = <0x1000000>;
						qcom,dump-id = <0x240>;
						qcom,instance = <0x2>;
					};
				};
			};
		};

