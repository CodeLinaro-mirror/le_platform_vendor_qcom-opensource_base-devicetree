		power-domains = <&scmi13_pd 2>, <&scmi13_pd 3>;
		power-domain-names = "usb_transfer", "usb_core";

		qcom,dev-name = "scmi_usb1_qmp";
	};

	scmi_infra0 {
		compatible = "qcom,uscmi";
		power-domains = <&scmi48_dvfs 0>, <&scmi48_dvfs 1>,
				<&scmi48_dvfs 2>, <&scmi48_dvfs 3>;
		power-domain-names = "cx", "mx", "mm", "mxc";

		qcom,dev-name = "scmi_infra0";
	};

	qfprom_tcsr_softsku: qfprom@1f97070 {
		compatible = "qcom,qfprom";
		reg = <0x0 0x1f97070 0x0 0x18>;
		#address-cells = <1>;
		#size-cells = <1>;
	};

	qfprom_tcsr_qtv: qfprom@1f96004 {
		compatible = "qcom,qfprom";
		reg = <0x0 0x1f96004 0x0 0x18>;
		#address-cells = <1>;
		#size-cells = <1>;
	};

	/*
	 * Vsense Calibration Fuse
	 * QFPROM_CORR_CALIBRATION_ROW124_MSB @ 0x360CA5AC
	 * Bits [28:26]:
	 *   0x0       -> Vsense calibration not fused -> voltage monitoring must not be enabled
	 *   0x1 - 0x7 -> Vsense calibration fused     -> voltage monitoring can be enabled
	 */
	qfprom_vsense: qfprom@360ca5ac {
		compatible = "qcom,qfprom";
		reg = <0x0 0x360ca5ac 0x0 0x4>;
		#address-cells = <1>;
		#size-cells = <1>;
	};

	/*
	 * BIST / SMC Fuse
	 * QFPROM_CORR_QC_CONFIG_ROW1_MSB @ 360D420C
	 * Bit 22 (SMC_EN):
	 *   0x0 -> SMC_EN not blown -> BIST capable
	 *   0x1 -> SMC_EN blown     -> BIST not capable
	 */
	qfprom_bist: qfprom@360D420C {
		compatible = "qcom,qfprom";
		reg = <0x0 0x360D420C 0x0 0x4>;
		#address-cells = <1>;
		#size-cells = <1>;
	};

	pdp0_log: qcom,pdp0_log@8764a000 {
		compatible = "qcom,pdp-log";
		reg = <0x0 0x8764a000 0x0 0x10000>;
		mboxes = <&pdp0_mbox 3>, <&pdp0_mbox 2>;
		qcom,log-type = <1>;
	};

	pdp1_log: qcom,pdp1_log@8768a000 {
		compatible = "qcom,pdp-log";
		reg = <0x0 0x8768a000 0x0 0x10000>;
		mboxes = <&pdp0_mbox 4>, <&pdp0_mbox 2>;
		qcom,log-type = <2>;
	};

	pdp2_log: qcom,pdp2_log@876ca000 {
		compatible = "qcom,pdp-log";
		reg = <0x0 0x876ca000 0x0 0x10000>;
		mboxes = <&pdp0_mbox 5>, <&pdp0_mbox 2>;
		qcom,log-type = <3>;
	};
};

