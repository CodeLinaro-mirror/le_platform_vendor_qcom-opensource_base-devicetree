&soc {
	auto_vm1: qcom,auto_vm1@8F0000000 {
		reg = <0x8 0xF0000000 0x0 0x2000000>; /*32MB*/
		vm_name = "autoghgvmlv";
		shared-buffers = <&auto_vm1_vblk0_ring
				&auto_vm1_vblk1_ring
				&auto_vm1_vblk2_ring
				&auto_vm1_vblk3_ring
				&auto_vm1_vblk4_ring
