&{/reserved-memory} {
	#address-cells = <2>;
	#size-cells = <2>;
	ranges;

	auto_vm1_vblk0_ring: auto_vm1_vblk0_ring@8f0000000 {
		no-map;
		reg = <0x8 0xF0000000 0x0 0x4000>;
		gunyah-label = <0x100>;
	};

