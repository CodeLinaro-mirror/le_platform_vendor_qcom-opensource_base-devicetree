				&auto_vm1_vblk20_ring
				&auto_vm1_vblk21_ring
				&auto_vm1_resv0_ring
				&auto_vm1_resv1_ring
				&auto_vm1_swiotlb>;
	};

	auto_vm1_be0: auto_vm1_be0@100 {
		qcom,vm = <&auto_vm1>;
		qcom,label = <0x100>;
	};

