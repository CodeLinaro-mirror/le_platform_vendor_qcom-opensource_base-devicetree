&spi14 {
	status = "okay";
	spidev@0 {
		compatible = "micron,spi-authenta";
		reg = <0>;
		spi-max-frequency = <10000000>;
	};
};

&usb_1_eusbphy {
	status = "okay";
};

&usb_1_qmpphy {
	status = "okay";
};

&usb_1 {
	status = "okay";
};

&usb_2_eusbphy {
	status = "okay";
};

&usb_2 {
	status = "okay";
};

&pcie0 {
	power-domains = <&scmi5_pd 0>;
	power-domain-names = "power";
};

&pcie1 {
	power-domains = <&scmi6_pd 0>;
	power-domain-names = "power";
};

&pcie2 {
	power-domains = <&scmi32_pd 0>;
	power-domain-names = "power";
};

&pcie3 {
	power-domains = <&scmi33_pd 0>;
	power-domain-names = "power";
};

