&thermal_zones {
	cpu-0-1-0 {
		trips {
			cpu1_alert0: trip-point1 {
				temperature = <116000>;
				hysteresis = <3000>;
			};
		};

		cooling-maps {
			map0 {
				trip = <&cpu1_alert0>;
				cooling-device = <&CPU1_idle 100 100>;
			};
		};
	};

