		ccu_qup: ccu-qup {
			compatible = "qcom,ccu-qup";
			#address-cells = <2>;
			#size-cells = <2>;
			reg = <0x0 0x09b96000 0x0 0x1000>,
			      <0x0 0x09c16000 0x0 0x1000>,
			      <0x0 0x09c1e000 0x0 0x1000>,
			      <0x0 0x09c1f000 0x0 0x1000>,
			      <0x0 0x09c20000 0x0 0x1000>;
			reg-names = "ccu_qupv3_0_common",
				    "ccu_qupv3_1_common",
				    "ccu_top",
				    "ccu_qupv3_0_IRQ",
				    "ccu_qupv3_1_IRQ";
			qcom,common-reg-offset = <0x40000>;
			interrupts = <GIC_ESPI 29 IRQ_TYPE_EDGE_RISING>,
					     <GIC_ESPI 28 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "ccu_qup0_irq",
					  "ccu_qup1_irq";
			ranges;
			status = "disabled";

			ccu_gpi_dma0: dma-controller0@9b56000 {
				compatible = "qcom,sa8797-ccu-gpi-dma";
