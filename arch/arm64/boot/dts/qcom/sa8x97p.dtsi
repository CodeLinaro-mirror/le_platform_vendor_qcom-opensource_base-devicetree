	xpcs0: xpcs@0x1A14000 {
		compatible = "qcom,xpcs";
		reg = <0x0 0x1A14000 0x0 0x5100>;
		reg-names = "qxpcs";
		interrupts = <GIC_SPI 713 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "sfty";
	};

	xpcs1: xpcs@0x1A94000 {
		status = "disabled";
		compatible = "qcom,xpcs";
		reg = <0x0 0x1A94000 0x0 0x5100>;
		reg-names = "qxpcs";
		interrupts = <GIC_SPI 361 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "sfty";
	};

	ethernet0: ethernet@0x1A00000 {
		compatible = "qcom,sa8797p-ethqos", "snps,dwxgmac";
		reg = <0x0 0x1A00000 0x0 0x14000>,
		      <0x0 0x1A7F000 0x0 0x1000>;
		reg-names = "stmmaceth", "rgmii";

		interrupts = <GIC_SPI 821 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 713 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "macirq", "sfty";

		iommus = <&apps_smmu_2 0x1201 0x2>,
			 <&apps_smmu_2 0x1202 0x0>,
			 <&apps_smmu_2 0x1203 0x2>,
			 <&apps_smmu_2 0x1204 0x0>,
			 <&apps_smmu_2 0x1205 0x2>,
			 <&apps_smmu_2 0x1206 0x0>,
			 <&apps_smmu_2 0x1207 0x2>;

		power-domains = <&scmi7_pd 0>, <&scmi7_pd 1>, <&scmi7_dvfs 0>, <&scmi7_dvfs 1>;
		power-domain-names = "power_core", "power_mdio", "perf_serdes", "perf_5g_serdes";

		pinctrl-0 = <&ethernet0_default>;
		pinctrl-names = "default";

		snps,tso;

		snps,pbl = <0x10>;
		dma-coherent;

		rx-fifo-depth = <98304>;
		tx-fifo-depth = <98304>;

		snps,axi-config = <&stmmac_axi_setup>;
		snps,mtl-rx-config = <&mtl_rx_setup>;
		snps,mtl-tx-config = <&mtl_tx_setup>;

		qcom-xpcs-handle = <&xpcs0>;

		mtl_rx_setup: rx-queues-config {
			snps,rx-queues-to-use = <7>;
			snps,rx-sched-sp;

			queue0 {
				snps,dcb-algorithm;
				snps,map-to-dma-channel = <0x0>;
				snps,route-up;
			};

			queue1 {
				snps,dcb-algorithm;
				snps,map-to-dma-channel = <0x1>;
				snps,route-ptp;
			};

			queue2 {
				snps,avb-algorithm;
				snps,map-to-dma-channel = <0x2>;
				snps,route-avcp;
			};

			queue3 {
				snps,avb-algorithm;
				snps,map-to-dma-channel = <0x3>;
				snps,priority = <0xc>;
			};

			queue4 {
				snps,dcb-algorithm;
				snps,map-to-dma-channel = <0x4>;
			};

			queue5 {
				snps,dcb-algorithm;
				snps,map-to-dma-channel = <0x5>;
			};

			queue6 {
				snps,dcb-algorithm;
				snps,map-to-dma-channel = <0x6>;
			};
		};

		mtl_tx_setup: tx-queues-config {
			snps,tx-queues-to-use = <7>;
			snps,tx-sched-sp;

			queue0 {
				snps,dcb-algorithm;
			};

			queue1 {
				snps,dcb-algorithm;
			};

			queue2 {
				snps,dcb-algorithm;
			};

			queue3 {
				snps,dcb-algorithm;
			};

			queue4 {
				snps,dcb-algorithm;
			};

			queue5 {
				snps,dcb-algorithm;
			};

			queue6 {
				snps,dcb-algorithm;
			};
		};

		stmmac_axi_setup: stmmac-axi-config {
			snps,rd_osr_lmt = <0x10>;
			snps,wr_osr_lmt = <0x10>;
			snps,kbbe;
			snps,blen = <0 0 0 0 16 0 0>;
		};
	};

	ethernet1: ethernet@0x01A80000 {
		status = "disabled";
		compatible = "qcom,sa8797p-ethqos", "snps,dwxgmac";
		reg = <0x0 0x01A80000 0x0 0x14000>,
		      <0x0 0x01AFF000 0x0 0x1000>;
		reg-names = "stmmaceth", "rgmii";

		interrupts = <GIC_SPI 820 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 361 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "macirq", "sfty";

		iommus = <&apps_smmu_2 0x11c1 0x8>,
			 <&apps_smmu_2 0x11c2 0x1>,
			 <&apps_smmu_2 0x11c3 0x1>,
			 <&apps_smmu_2 0x11c4 0x3>,
			 <&apps_smmu_2 0x11c5 0x3>,
			 <&apps_smmu_2 0x11c6 0x3>,
			 <&apps_smmu_2 0x11c7 0x3>;

		power-domains = <&scmi8_pd 0>, <&scmi8_pd 1>, <&scmi8_dvfs 0>, <&scmi8_dvfs 1>;
		power-domain-names = "power_core", "power_mdio", "perf_serdes", "perf_5g_serdes";

		pinctrl-0 = <&ethernet1_default>;
		pinctrl-names = "default";

		snps,tso;

		snps,pbl = <0x10>;
		dma-coherent;

		rx-fifo-depth = <98304>;
		tx-fifo-depth = <98304>;

		snps,axi-config = <&stmmac_axi_setup1>;
		snps,mtl-rx-config = <&mtl_rx_setup1>;
		snps,mtl-tx-config = <&mtl_tx_setup1>;

		qcom-xpcs-handle = <&xpcs1>;

		mtl_rx_setup1: rx-queues-config {
			snps,rx-queues-to-use = <7>;
			snps,rx-sched-sp;

			queue0 {
				snps,dcb-algorithm;
				snps,map-to-dma-channel = <0x0>;
				snps,route-up;
			};

			queue1 {
				snps,dcb-algorithm;
				snps,map-to-dma-channel = <0x1>;
				snps,route-ptp;
			};

			queue2 {
				snps,avb-algorithm;
				snps,map-to-dma-channel = <0x2>;
				snps,route-avcp;
			};

			queue3 {
				snps,avb-algorithm;
				snps,map-to-dma-channel = <0x3>;
				snps,priority = <0xc>;
			};

			queue4 {
				snps,dcb-algorithm;
				snps,map-to-dma-channel = <0x4>;
			};

			queue5 {
				snps,dcb-algorithm;
				snps,map-to-dma-channel = <0x5>;
			};

			queue6 {
				snps,dcb-algorithm;
				snps,map-to-dma-channel = <0x6>;
			};
		};

		mtl_tx_setup1: tx-queues-config {
			snps,tx-queues-to-use = <7>;
			snps,tx-sched-sp;

			queue0 {
				snps,dcb-algorithm;
			};

			queue1 {
				snps,dcb-algorithm;
			};

			queue2 {
				snps,dcb-algorithm;
			};

			queue3 {
				snps,dcb-algorithm;
			};

			queue4 {
				snps,dcb-algorithm;
			};

			queue5 {
				snps,dcb-algorithm;
			};

			queue6 {
				snps,dcb-algorithm;
			};
		};

		stmmac_axi_setup1: stmmac-axi-config {
			snps,rd_osr_lmt = <0x10>;
			snps,wr_osr_lmt = <0x10>;
			snps,kbbe;
			snps,blen = <0 0 0 0 16 0 0>;
		};
	};
};

