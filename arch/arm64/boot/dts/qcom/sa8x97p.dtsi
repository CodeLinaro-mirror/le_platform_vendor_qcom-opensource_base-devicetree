		tcsr_mutex: hwlock@1f40000 {
			compatible = "qcom,tcsr-mutex";
			reg = <0x0 0x01f40000 0x0 0x20000>;
			#hwlock-cells = <1>;
		};

		tcsr: syscon@1f60000 {
			compatible = "syscon";
			reg = <0x0 0x1f60000 0x0 0xa0000>;
		};

		gpio-keys {
			compatible = "gpio-keys";

			key_power {
				label = "power";
				linux,code = <KEY_POWER>;
				gpios = <&tlmm 166 GPIO_ACTIVE_HIGH>;
				linux,input-type = <1>;
				debounce-interval = <0>;
				wakeup-source;
			};
		};

		tsens0: thermal-sensor@c22c000 {
			compatible = "qcom,sa8797p-tsens", "qcom,tsens-v2";
			reg = <0x0 0x0c22c000 0x0 0x1ff>,
			      <0x0 0x0c222000 0x0 0x8>;
			interrupts = <GIC_SPI 771 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 484 IRQ_TYPE_LEVEL_HIGH>;
			#qcom,sensors = <16>;
			interrupt-names = "uplow", "critical";
			#thermal-sensor-cells = <1>;
		};

		tsens1: thermal-sensor@c22d000 {
			compatible = "qcom,sa8797p-tsens", "qcom,tsens-v2";
			reg = <0x0 0x0c22d000 0x0 0x1ff>,
			      <0x0 0x0c223000 0x0 0x8>;
			interrupts = <GIC_SPI 772 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 485 IRQ_TYPE_LEVEL_HIGH>;
			#qcom,sensors = <16>;
			interrupt-names = "uplow", "critical";
			#thermal-sensor-cells = <1>;
		};

		tsens2: thermal-sensor@c22e000 {
			compatible = "qcom,sa8797p-tsens", "qcom,tsens-v2";
			reg = <0x0 0x0c22e000 0x0 0x1ff>,
			      <0x0 0x0c224000 0x0 0x8>;
			interrupts = <GIC_SPI 773 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 486 IRQ_TYPE_LEVEL_HIGH>;
			#qcom,sensors = <16>;
			interrupt-names = "uplow", "critical";
			#thermal-sensor-cells = <1>;
		};

		tsens3: thermal-sensor@c22f000 {
			compatible = "qcom,sa8797p-tsens", "qcom,tsens-v2";
			reg = <0x0 0x0c22f000 0x0 0x1ff>,
			      <0x0 0x0c225000 0x0 0x8>;
			interrupts = <GIC_SPI 774 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 487 IRQ_TYPE_LEVEL_HIGH>;
			#qcom,sensors = <16>;
			interrupt-names = "uplow", "critical";
			#thermal-sensor-cells = <1>;
		};

		tsens4: thermal-sensor@c230000 {
			compatible = "qcom,sa8797p-tsens", "qcom,tsens-v2";
			reg = <0x0 0x0c230000 0x0 0x1ff>,
			      <0x0 0x0c226000 0x0 0x8>;
			interrupts = <GIC_SPI 775 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 399 IRQ_TYPE_LEVEL_HIGH>;
			#qcom,sensors = <16>;
			interrupt-names = "uplow", "critical";
			#thermal-sensor-cells = <1>;
		};

		tsens5: thermal-sensor@c231000 {
			compatible = "qcom,sa8797p-tsens", "qcom,tsens-v2";
			reg = <0x0 0x0c231000 0x0 0x1ff>,
			      <0x0 0x0c227000 0x0 0x8>;
			interrupts = <GIC_SPI 776 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 400 IRQ_TYPE_LEVEL_HIGH>;
			#qcom,sensors = <16>;
			interrupt-names = "uplow", "critical";
			#thermal-sensor-cells = <1>;
		};

		tsens6: thermal-sensor@c232000 {
			compatible = "qcom,sa8797p-tsens", "qcom,tsens-v2";
			reg = <0x0 0x0c232000 0x0 0x1ff>,
			      <0x0 0x0c228000 0x0 0x8>;
			interrupts = <GIC_SPI 777 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 401 IRQ_TYPE_LEVEL_HIGH>;
			#qcom,sensors = <16>;
			interrupt-names = "uplow", "critical";
			#thermal-sensor-cells = <1>;
		};

		tsens7: thermal-sensor@c233000 {
			compatible = "qcom,sa8797p-tsens", "qcom,tsens-v2";
			reg = <0x0 0x0c233000 0x0 0x1ff>,
			      <0x0 0x0c229000 0x0 0x8>;
			interrupts = <GIC_SPI 778 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 402 IRQ_TYPE_LEVEL_HIGH>;
			#qcom,sensors = <16>;
			interrupt-names = "uplow", "critical";
			#thermal-sensor-cells = <1>;
		};

		tlmm: pinctrl@f000000 {
			compatible = "qcom,sa8797p-tlmm";
			reg = <0x0 0x0f000000 0x0 0x1000000>;
			interrupts = <GIC_SPI 208 IRQ_TYPE_LEVEL_HIGH>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
			gpio-ranges = <&tlmm 0 0 181>;
			wakeup-parent = <&pdc>;
		};

		intc: interrupt-controller@17000000 {
			compatible = "arm,gic-v3";
			reg = <0x0 0x17000000 0x0 0x10000>,     /* GICD */
			      <0x0 0x17080000 0x0 0x480000>;    /* GICR * 18 */
			interrupt-controller;
			#address-cells = <2>;
			#size-cells = <2>;
			#interrupt-cells = <3>;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
			#redistributor-regions = <1>;
			redistributor-stride = <0x0 0x40000>;
			ranges;

			gic_its: msi-controller@17040000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x17040000 0x0 0x40000>;
				msi-controller;
				#msi-cells = <1>;
			};
		};

		sram@c30f000 {
			compatible = "qcom,rpmh-stats";
			reg = <0x0 0xC30F000 0x0 0x400>;
		};

		pdc: interrupt-controller@b220000 {
			compatible = "qcom,sa8797p-pdc", "qcom,pdc";
			reg = <0x0 0xb220000 0x0 0x10000>;
			qcom,pdc-ranges = <0 745 43>, <67 543 31>, <98 609 32>,
					  <130 717 12>, <142 251 5>, <147 796 16>;
			#interrupt-cells = <2>;
			interrupt-parent = <&intc>;
			interrupt-controller;
		};

		memtimer: timer@17810000 {
			compatible = "arm,armv7-timer-mem";
			reg = <0x0 0x17810000 0x0 0x1000>;
			ranges = <0x0 0x0 0x0 0x20000000>;
			clock-frequency = <19200000>;
			#address-cells = <1>;
			#size-cells = <1>;

			frame@17811000 {
				reg = <0x17811000 0x1000>,
				      <0x17812000 0x1000>;
				interrupts = <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH>,
					     <GIC_SPI 31 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <0>;
			};

			frame@17813000 {
				reg = <0x17813000 0x1000>;
				interrupts = <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <1>;
				status = "disabled";
			};

			frame@17815000 {
				reg = <0x17815000 0x1000>;
				interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <2>;
				status = "disabled";
			};

			frame@17817000 {
				reg = <0x17817000 0x1000>;
				interrupts = <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <3>;
				status = "disabled";
			};

			frame@17819000 {
				reg = <0x17819000 0x1000>;
				interrupts = <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <4>;
				status = "disabled";
			};

			frame@1781b000 {
				reg = <0x1781b000 0x1000>;
				interrupts = <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <5>;
				status = "disabled";
			};

			frame@1781d000 {
				reg = <0x1781d000 0x1000>;
				interrupts = <GIC_SPI 44 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <6>;
				status = "disabled";
			};
		};

		watchdog@17821000 {
			compatible = "qcom,apss-wdt-sa8797p", "qcom,win-wdt";
			reg = <0x0 0x17821000 0x0 0x1000>;
			clocks = <&xo_board_clk>;
			interrupts = <GIC_SPI 24 IRQ_TYPE_LEVEL_HIGH>;
		};

		arch_timer: timer {
			compatible = "arm,armv8-timer";
			interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
				     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
				     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
				     <GIC_PPI 12 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>;
			clock-frequency = <19200000>;
		};

		ipcc0: mailbox@9007000 {
			compatible = "qcom,sa8797p-ipcc", "qcom,ipcc";
			reg = <0x0 0x9007000 0x0 0x1000>;
			interrupts = <GIC_SPI 247 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-controller;
			#interrupt-cells = <3>;
			#mbox-cells = <2>;
		};

		ipcc1: mailbox@90c5000 {
			compatible = "qcom,sa8797p-ipcc", "qcom,ipcc";
			reg = <0x0 0x90c5000 0x0 0x1000>;
			interrupts = <GIC_SPI 230 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-controller;
			#interrupt-cells = <3>;
			#mbox-cells = <2>;
		};

		ipcc2: mailbox@9185000 {
			compatible = "qcom,sa8797p-ipcc", "qcom,ipcc";
			reg = <0x0 0x9185000 0x0 0x1000>;
			interrupts = <GIC_SPI 231 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-controller;
			#interrupt-cells = <3>;
			#mbox-cells = <2>;
		};

		apps_smmu_0: iommu@15a00000 {
			compatible = "qcom,sa8797p-smmu-500", "qcom,smmu-500", "arm,mmu-500";
			reg = <0x0 0x15A00000 0x0 0x100000>;
			#iommu-cells = <2>;
			#global-interrupts = <1>;
			dma-coherent;
		};

		apps_smmu_1: iommu@15c00000 {
			compatible = "qcom,sa8797p-smmu-500", "qcom,smmu-500", "arm,mmu-500";
			reg = <0x0 0x15C00000 0x0 0x100000>;
			#iommu-cells = <2>;
			#global-interrupts = <1>;
			dma-coherent;
		};

		apps_smmu_2: iommu@15e00000 {
			compatible = "qcom,sa8797p-smmu-500", "qcom,smmu-500", "arm,mmu-500";
			reg = <0x0 0x15E00000 0x0 0x100000>;
			#iommu-cells = <2>;
			#global-interrupts = <1>;
			dma-coherent;
		};

		pcie_smmu: iommu@9980000 {
			compatible = "arm,smmu-v3";
			reg = <0x0 0x9980000 0x0 0x20000>;
			interrupts = <GIC_SPI 898 IRQ_TYPE_EDGE_RISING>,
				<GIC_SPI 900 IRQ_TYPE_EDGE_RISING>,
				<GIC_SPI 902 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "eventq", "cmdq-sync", "gerror";
			dma-coherent;
			#iommu-cells = <1>;
			status = "disabled";
		};

		rng: rng@10c3000 {
			compatible = "qcom,sa8797p-trng", "qcom,trng";
			reg = <0x0 0x10c3000 0x0 0x1000>;
		};

		ufshc_mem: ufshc@1d44000 {
			compatible = "qcom,sa8255p-ufshc", "qcom,ufshc", "jedec,ufs-2.0";
			reg =	<0x0 0x1D44000 0x0 0x3000>,
				<0x0 0x1D65000 0x0 0x2000>,
				<0x0 0x1D64000 0x0 0x10>;
			reg-names = "ufs_mem", "mcq_sqd", "mcq_vs";

			interrupts = <GIC_SPI 265 IRQ_TYPE_LEVEL_HIGH>;
			lanes-per-direction = <1>;
			#reset-cells = <1>;

			msi-parent = <&gic_its 0x14C0>;

			iommus = <&apps_smmu_0 0x14C0 0x0>;

			reset-gpios = <&tlmm 181 GPIO_ACTIVE_LOW>;

			power-domains = <&scmi3_pd 0>;
			power-domain-names = "power";

			qcom,ice = <&ice>;
			status = "okay";
		};

		ice: crypto@1d48000 {
			compatible = "qcom,sa8255p-inline-crypto-engine",
				     "qcom,inline-crypto-engine";
			reg = <0x0 0x01d48000 0x0 0x10000>;
			qcom,ice-use-hwkm;
			qcom,ice-skip-clk;
		};

		adreno_smmu_0: iommu@3da0000 {
			compatible = "qcom,sa8797p-smmu-500", "qcom,adreno-smmu",
				     "qcom,smmu-500", "arm,mmu-500";
			reg = <0x0 0x03da0000 0x0 0x40000>;
			#iommu-cells = <2>;
			#global-interrupts = <1>;
			dma-coherent;
			interrupts = <GIC_SPI 673 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 678 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 679 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 680 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 681 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 682 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 683 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 684 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 685 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 686 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 687 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 688 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 422 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 476 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 679 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 574 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 575 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 576 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 577 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 660 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 662 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 665 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 666 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 667 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 669 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 670 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 670 IRQ_TYPE_LEVEL_HIGH>;

			power-domains = <&scmi15_pd 0>;
			power-domain-names = "power";
		};

		adreno_smmu_1: iommu@98a0000 {
			compatible = "qcom,sa8797p-smmu-500", "qcom,adreno-smmu",
				     "qcom,smmu-500", "arm,mmu-500";
			reg = <0x0 0x098a0000 0x0 0x40000>;
			#iommu-cells = <2>;
			#global-interrupts = <1>;
			dma-coherent;
			interrupts = <GIC_SPI 932 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 936 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 937 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 938 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 939 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 940 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 941 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 942 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 924 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 925 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 926 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 927 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 928 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 929 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 920 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 921 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 922 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 851 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 852 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 853 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 854 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 855 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 856 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 857 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 858 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 859 IRQ_TYPE_LEVEL_HIGH>;

			power-domains = <&scmi15_pd 1>;
			power-domain-names = "power";
		};

		pdp_mbox0: mailbox@19980000 {
			compatible = "qcom,x1e80100-cpucp-mbox";
			reg = <0x0 0x19980000 0x0 0x300>,
				<0x0 0x17610000 0x0 0x4c08>;
			reg-names = "tx", "rx";
			qcom,rx-chans = <0xB>;
			#mbox-cells = <1>;
			interrupts = <GIC_SPI 56 IRQ_TYPE_LEVEL_HIGH>;
		};

		pdp_mbox1: mailbox@1a980000 {
			compatible = "qcom,x1e80100-cpucp-mbox";
			reg = <0x0 0x1a980000 0x0 0x300>,
				<0x0 0x17610000 0x0 0x4c08>;
			reg-names = "tx", "rx";
			#mbox-cells = <1>;
			qcom,rx-chans = <0x10>;
			interrupts = <GIC_SPI 56 IRQ_TYPE_LEVEL_HIGH>;
		};

		pdp_mbox2: mailbox@1b980000 {
			compatible = "qcom,x1e80100-cpucp-mbox";
			reg = <0x0 0x1b980000 0x0 0x300>,
				<0x0 0x17610000 0x0 0x4c08>;
			reg-names = "tx", "rx";
			#mbox-cells = <1>;
			qcom,rx-chans = <0x20>;
			interrupts = <GIC_SPI 56 IRQ_TYPE_LEVEL_HIGH>;
		};

		pdp0_log: qcom,pdp0_log@8764a000 {
			compatible = "qcom,pdp-log";
			reg =	<0x0 0x8764a000 0x0 0x10000>;
			mboxes = <&pdp_mbox0 3>, <&pdp_mbox0 2>;
			qcom,log-type = <1>;
		};

		pdp1_log: qcom,pdp1_log@8764a000 {
			compatible = "qcom,pdp-log";
			reg =	<0x0 0x8768a000 0x0 0x10000>;
			mboxes = <&pdp_mbox1 4>, <&pdp_mbox1 2>;
			qcom,log-type = <2>;
		};

		pdp2_log: qcom,pdp2_log@876ca000 {
			compatible = "qcom,pdp-log";
			reg =	<0x0 0x876ca000 0x0 0x10000>;
			mboxes = <&pdp_mbox2 5>, <&pdp_mbox2 2>;
			qcom,log-type = <3>;
		};

		dcc: dma@100ff000 {
			compatible = "qcom,sa8797p-dcc", "qcom,dcc-v3";
			#address-cells = <2>;
			#size-cells = <2>;
			reg = <0x0 0x100ff000 0x0 0x1000>,
				<0x0 0x10080000 0x0 0x6000>;
			qcom,dcc-offset = <0>;
		};

		cpucp_mbox: mailbox@18830000 {
			compatible = "qcom,x1e80100-cpucp-mbox";
			reg =	<0x0 0x18830000 0x0 0x300>,
				<0x0 0x17620000 0x0 0x4C08>;
			reg-names = "tx", "rx";
			#mbox-cells = <1>;
			interrupts = <GIC_SPI 50 IRQ_TYPE_LEVEL_HIGH>;
		};

		qcom,msm-imem@14680000 {
			compatible = "qcom,msm-imem";
			reg = <0x0 0x14680000 0x0 0x1000>;
			ranges = <0x0 0x0 0x14680000 0x1000>;
			#address-cells = <1>;
			#size-cells = <1>;

			mem_dump_table@10 {
				compatible = "qcom,msm-imem-mem-dump-table";
				reg = <0x10 0x8>;
			};
		};

		mem-dump {
			compatible = "qcom,mem-dump-v21";
			memory-region = <&dump_mem>;

			static_dump {
				qcom,static-mem-dump;

				c0-context {
					qcom,dump-id = <0x0>;
					qcom,dump-size = <0x800>;
				};

				c1-context {
					qcom,dump-id = <0x1>;
					qcom,dump-size = <0x800>;
				};

				c2-context {
					qcom,dump-id = <0x2>;
					qcom,dump-size = <0x800>;
				};

				c3-context {
					qcom,dump-id = <0x3>;
					qcom,dump-size = <0x800>;
				};

				c4-context {
					qcom,dump-id = <0x4>;
					qcom,dump-size = <0x800>;
				};

				c5-context {
					qcom,dump-id = <0x5>;
					qcom,dump-size = <0x800>;
				};

				c6-context {
					qcom,dump-id = <0x6>;
					qcom,dump-size = <0x800>;
				};

				c7-context {
					qcom,dump-id = <0x7>;
					qcom,dump-size = <0x800>;
				};

				c8-context {
					qcom,dump-id = <0x8>;
					qcom,dump-size = <0x800>;
				};

				c9-context {
					qcom,dump-id = <0x9>;
					qcom,dump-size = <0x800>;
				};

				c10-context {
					qcom,dump-id = <0xA>;
					qcom,dump-size = <0x800>;
				};

				c11-context {
					qcom,dump-id = <0xB>;
					qcom,dump-size = <0x800>;
				};

				c12-context {
					qcom,dump-id = <0xC>;
					qcom,dump-size = <0x800>;
				};

				c13-context {
					qcom,dump-id = <0xD>;
					qcom,dump-size = <0x800>;
				};

				c14-context {
					qcom,dump-id = <0xE>;
					qcom,dump-size = <0x800>;
				};

				c15-context {
					qcom,dump-id = <0xF>;
					qcom,dump-size = <0x800>;
				};

				c16-context {
					qcom,dump-id = <0x10>;
					qcom,dump-size = <0x800>;
				};

				c17-context {
					qcom,dump-id = <0x11>;
					qcom,dump-size = <0x800>;
				};

				pmic {
					qcom,dump-id = <0xe4>;
					qcom,dump-size = <0x80000>;
				};

				misc-data {
					qcom,dump-id = <0xe8>;
					qcom,dump-size = <0x1000>;
				};

				rpm-sw {
					qcom,dump-id = <0xea>;
					qcom,dump-size = <0x28000>;
				};

				rpmh {
					qcom,dump-id = <0xec>;
					qcom,dump-size = <0x2000000>;
				};

				fcm {
					qcom,dump-id = <0xee>;
					qcom,dump-size = <0x8400>;
				};

				tmc-etf {
					qcom,dump-id = <0xf0>;
					qcom,dump-size = <0x10000>;
				};

				etf-swao {
					qcom,dump-id = <0xf1>;
					qcom,dump-size = <0x8400>;
				};

				etr-reg {
					qcom,dump-id = <0x100>;
					qcom,dump-size = <0x1000>;
				};

