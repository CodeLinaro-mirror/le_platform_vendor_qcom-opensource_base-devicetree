		gpuss-1-2 {
			polling-delay-passive = <0>;
			polling-delay = <0>;

			thermal-sensors = <&tsens7 5>;

			trips {
				trip-point0 {
					temperature = <105000>;
					hysteresis = <10000>;
					type = "passive";
				};

				trip-point1 {
					temperature = <115000>;
					hysteresis = <10000>;
					type = "passive";
				};
