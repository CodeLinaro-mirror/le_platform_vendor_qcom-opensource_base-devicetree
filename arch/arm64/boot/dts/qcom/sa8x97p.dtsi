				};

				ccu_i2c3: i2c@9b8c000 {
					compatible = "qcom,sa8797p-geni-i2c-ccu";
					reg = <0x0 0x9b8c000 0x0 0x2000>;
					dmas = <&ccu_gpi_dma0 0 3 QCOM_GPI_I2C 10 512>,
					       <&ccu_gpi_dma0 1 3 QCOM_GPI_I2C 10 512>,
					       <&ccu_gpi_dma0 0 3 QCOM_GPI_I2C 11 512>,
					       <&ccu_gpi_dma0 1 3 QCOM_GPI_I2C 11 512>,
