/dts-v1/;

#include "sa8797p.dtsi"
/ {
	model = "Qualcomm Technologies, Inc. SA8797P Rumi";
	compatible = "qcom,sa8797p-rumi", "qcom,sa8797p";
	qcom,board-id = <0xf 0>;

	aliases {
		serial0 = &uart15;
	};

	chosen { };
};

&arch_timer {
	clock-frequency = <19200000>;
};

&memtimer {
	clock-frequency = <19200000>;
};

&sleep_clk {
	clock-frequency = <32768>;
};

&scmi11 {
	status = "okay";
};

&qupv3_id_2 {
	status = "okay";
};

&uart15 {
	status = "okay";
};

&tlmm {
	qupv3_se1_2uart_pins: qupv3_se1_2uart_pins {
		qupv3_se1_2uart_tx_active: qupv3_se1_2uart_tx_active {
			mux {
				pins = "gpio143";
				function = "qup2_se1_l2";
			};

			config {
				pins = "gpio143";
				drive-strength = <2>;
				bias-disable;
			};
		};

		qupv3_se1_2uart_rx_active: qupv3_se1_2uart_rx_active {
			mux {
				pins = "gpio144";
				function = "qup2_se1_l3";
			};

			config {
				pins = "gpio144";
				drive-strength = <2>;
				bias-disable;
			};
		};

		qupv3_se1_2uart_sleep: qupv3_se1_2uart_sleep {
			mux {
				pins = "gpio143", "gpio144";
				function = "gpio";
			};

			config {
				pins = "gpio143", "gpio144";
				drive-strength = <2>;
				bias-pull-down;
			};
		};
	};
};

&xo_board_clk {
	clock-frequency = <19200000>;
};

&scmi3 {
	status = "okay";
};
