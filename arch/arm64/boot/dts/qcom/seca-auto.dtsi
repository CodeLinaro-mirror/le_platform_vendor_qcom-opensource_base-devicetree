				temperature = <135000>;
				hysteresis = <5000>;
				type = "passive";
			};

			trip1 {
				temperature = <115000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};
	};

	pm_kai_1_thermal: pm-h-die-temp {
