&thermal_zones {
	cpu-0-0-0 {
		trips {
			trip-point2 {
				temperature = <115000>;
				hysteresis = <3000>;
				type = "critical";
			};
		};
	};

	cpu-0-1-0 {
		trips {
			trip-point2 {
				temperature = <115000>;
				hysteresis = <3000>;
				type = "critical";
			};

			cpu1_alert0: trip-point1 {
				temperature = <114000>;
				hysteresis = <3000>;
			};
		};

		cooling-maps {
			map0 {
				trip = <&cpu1_alert0>;
				cooling-device = <&CPU1_idle 100 100>;
			};
		};
	};

