	pdp_sram: pdp-sram@0x87608000 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "mmio-sram";
		reg = <0x0 0x87608000 0x0 0x300>;
		ranges = <0 0x0 0x87608000 0x300>;

		pdp0_p2a: scmi-shmem@0 {
			compatible = "arm,scmi-shmem";
			reg = <0x0 0x80>;
		};

		pdp0_a2p: scmi-shmem@180 {
			compatible = "arm,scmi-shmem";
			reg = <0x180 0x80>;
		};

		pdp1_p2a: scmi-shmem@80 {
			compatible = "arm,scmi-shmem";
			reg = <0x80 0x80>;
		};

		pdp1_a2p: scmi-shmem@200 {
			compatible = "arm,scmi-shmem";
			reg = <0x200 0x80>;
		};

		pdp2_p2a: scmi-shmem@100 {
			compatible = "arm,scmi-shmem";
			reg = <0x100 0x80>;
		};

		pdp2_a2p: scmi-shmem@280 {
