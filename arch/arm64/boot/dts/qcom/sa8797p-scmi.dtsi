			reg = <0x280 0x80>;
		};

	};

	cpucp_sram: cpucp-sram@18b3d000 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "mmio-sram";
		reg = <0x0 0x18b3d000 0x0 0x400>;
		ranges = <0 0x0 0x18b3d000 0x400>;

		cpucp0_tx: scmi-shmem@0 {
			compatible = "arm,scmi-shmem";
			reg = <0x0 0x200>;
		};

		cpucp0_rx: scmi-shmem@200 {
			compatible = "arm,scmi-shmem";
			reg = <0x200 0x200>;
		};

	};

	aop_sram_tx: aop-sram@c319000 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "mmio-sram";
		reg = <0x0 0xc319000 0x0 0x400>;
		ranges = <0 0x0 0xc319000 0x400>;

		aop0_a2p: aop0-a2p@0 {
			compatible = "arm,scmi-shmem";
			reg = <0x0 0x400>;
			reg-io-width = <4>;
		};
	};

	aop_sram_rx: aop-sram@c31a000 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "mmio-sram";
		reg = <0x0 0xc31a000 0x0 0x400>;
